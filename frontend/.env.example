# =============================================================================
# Velora frontend — environment variables
# =============================================================================
# Copy to .env.local for development:   cp .env.example .env.local
# On Vercel, add these under Settings -> Environment Variables.
#
# IMPORTANT: Vite inlines VITE_* values into the JavaScript bundle at BUILD
# time. They are visible to anyone who opens devtools, so never put a secret
# here — API keys belong on the backend only. These two are just URLs.
#
# Equally important: changing them on Vercel does nothing until you REDEPLOY,
# because the old value is already baked into the built files.
# =============================================================================

# Your Render backend URL. No trailing slash.
# Local:      http://localhost:5000
# Production: https://velora-api.onrender.com
VITE_API_URL=http://localhost:5000

# Socket.io endpoint. Defaults to VITE_API_URL, so leave this unset unless the
# WebSocket lives somewhere else.
# VITE_SOCKET_URL=
