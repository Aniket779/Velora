# =============================================================================
# Velora backend — environment variables
# =============================================================================
# Copy to .env for local development:   cp .env.example .env
# On Render, add each of these under Environment (NEVER commit real values).
# =============================================================================

# --- Database (required) -----------------------------------------------------
# MongoDB Atlas connection string. Note two things people get wrong:
#   - the database name goes BEFORE the "?"  ->  .../Velora?retryWrites=true
#   - special characters in the password must be URL-encoded (@ = %40)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Velora?retryWrites=true&w=majority

# --- Server ------------------------------------------------------------------
# Render injects PORT automatically. Leave unset there.
PORT=5000
NODE_ENV=development

# Browser origins allowed to call this API — comma-separated, no trailing slash.
# Production example:
#   CLIENT_URL=https://velora.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Optional: also allow this project's Vercel preview deploys.
# VERCEL_PREVIEW_PATTERN=^https://velora-[a-z0-9-]+\.vercel\.app$

# --- DNS (only if you hit querySrv ECONNREFUSED) -----------------------------
# Node resolves DNS itself rather than using the OS resolver the way nslookup
# does. If this machine's only nameserver is an IPv6 link-local address
# (fe80::...), Node usually cannot reach it — nslookup resolves fine while
# mongodb+srv:// fails, which makes it look like an Atlas fault.
# Uncomment to point Node at a resolver it can use. Local only; a deployed
# host never needs this.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Redis, for the BullMQ job queue (required) ------------------------------
# Upstash free tier is plenty. TLS is enabled automatically when a password is set.
REDIS_HOST=<name>.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=<password>
# REDIS_USERNAME=default

# --- Authentication (required) -----------------------------------------------
# Minimum 32 characters. The server refuses to start without it.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value in production than in local dev.
JWT_SECRET=<run the command above and paste the result>
JWT_EXPIRES_IN=7d

# --- AI provider (optional, but the app is a demo without it) ----------------
# Set ONE of these. Gemini wins if both are present — it has a free tier.
# Without either, the app still runs end to end but returns clearly-labelled
# placeholder content instead of generated itineraries.
GEMINI_API_KEY=
# Google moves the free-tier grant onto newer models and retires it from older
# ones, so a model that worked last month can return "limit: 0" today.
# Run `npm run check-ai` — it probes every model your key can see and names one
# that actually has quota. Add --all to compare, and prefer a non-lite "flash":
# Velora asks for a large strict-schema JSON itinerary and the heavier models
# hold that schema together more reliably.
GEMINI_MODEL=gemini-3.1-flash-lite

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-2024-08-06

# --- Tuning (all optional, defaults shown) -----------------------------------
# AI_WORKER_CONCURRENCY=3
# AI_MAX_ATTEMPTS=3
# AI_TIMEOUT_MS=90000
# AI_RATE_LIMIT_WAIT_MS=30000
# DESTINATION_INTELLIGENCE_TTL_DAYS=90
